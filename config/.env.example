# Crie em https://myanimelist.net/apiconfig (App Type: other)
MAL_CLIENT_ID=

# Neo4j local (docker compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Embeddings via oMLX (API compatível com OpenAI)
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=
EMBEDDING_MODEL=bge-m3-mlx-fp16

# Modelo que gera Cypher (python -m analytics)
CYPHER_MODEL=gpt-oss-20b-MXFP4-Q8

# Agente (python -m agent, interface web)
# AGENT_BACKEND: omlx (local) ou anthropic (Claude)
AGENT_BACKEND=omlx
# Opcionais. AGENT_MODEL padrão: CYPHER_MODEL no oMLX, claude-opus-5-5 no Claude.
# AGENT_EFFORT e ANTHROPIC_API_KEY só valem para AGENT_BACKEND=anthropic.
# AGENT_MODEL=
# AGENT_EFFORT=medium
# ANTHROPIC_API_KEY=
